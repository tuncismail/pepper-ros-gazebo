<launch>

  <!-- Argument for simulation vs. real robot -->
  <!-- Set to true if using Gazebo or another simulator that publishes /clock -->
  <arg name="sim_time" default="false" />
  <param name="use_sim_time" value="$(arg sim_time)" />

  <!-- ===== ROBOT SPECIFIC PARAMETERS - YOU MUST CHANGE THESE! ===== -->
  <arg name="laser_scan_topic" default="/real_scan" />   <!-- Your laser scan topic -->
  <arg name="laser_frame_id"   default="laser" />        <!-- The frame_id in your laser scan messages -->
  <arg name="base_frame_id"    default="base_link" />    <!-- Your robot's base frame -->
  <arg name="odom_frame_id"    default="odom" />         <!-- Your robot's odometry frame -->

  <!-- Static Transform: base_frame -> laser_frame -->
  <!-- Args: x y z yaw pitch roll parent_frame child_frame period_in_ms -->
  <!-- IMPORTANT: Replace X_OFFSET, Y_OFFSET, etc., with your measured values! -->
  <!-- Example: Laser 0.2m forward, 0.1m up, no rotation, from base_link -->
  <node pkg="tf" type="static_transform_publisher" name="base_to_laser_broadcaster"
        args="0.2 0 0.1 0 0 0 $(arg base_frame_id) $(arg laser_frame_id) 100" />
  <!--
      If your laser has a different name in the scan message than what you want for TF,
      ensure laser_frame_id here matches what's in the scan message.
  -->

  <!-- ===== SLAM GMAPPING ===== -->
  <node name="slam_gmapping" pkg="gmapping" type="slam_gmapping" output="screen">
    <!-- Frames -->
    <param name="base_frame" value="$(arg base_frame_id)"/>
    <param name="odom_frame" value="$(arg odom_frame_id)"/>
    <param name="map_frame"  value="map"/>                 <!-- Standard name for the map frame -->

    <!-- Input/Output -->
    <remap from="scan" to="$(arg laser_scan_topic)"/>
    <!-- <remap from="odom" to="/your_actual_odom_topic_if_not_default_odom"/> -->

    <!-- General Parameters -->
    <param name="map_update_interval" value="2.0"/>     <!-- How often to publish the map (s) -->
    <param name="transform_tolerance" value="0.5"/>     <!-- How long to wait for transform (s). Increase if getting TF errors in sim. -->
    <param name="delta" value="0.05"/>                  <!-- Map resolution (meters/pixel) -->

    <!-- Laser Parameters -->
    <param name="maxUrange" value="5.5"/>               <!-- Max usable range of the laser (m). SET THIS TO YOUR SENSOR'S SPEC! -->
    <param name="maxRange" value="8.0"/>                <!-- Max range of the laser (m). Should be >= maxUrange. -->
    <!-- <param name="minimumScore" value="200"/> -->   <!-- Optional: min score for scan matching. Adjust if map quality is poor. -->

    <!-- Particle Filter Parameters -->
    <param name="particles" value="30"/>                <!-- Number of particles. More = more CPU, potentially more robust. 30-80 is common. -->
    <param name="linearUpdate" value="0.2"/>            <!-- Process scan if robot moved this much (m) -->
    <param name="angularUpdate" value="0.2"/>           <!-- Process scan if robot turned this much (rad) -->
    <param name="temporalUpdate" value="-1.0"/>         <!-- Process scan if this time passed (s). -1 to disable if linear/angular are frequent. Try 0.5 if needed. -->
    <param name="resampleThreshold" value="0.5"/>       <!-- Higher means resampling less often -->

    <!-- Odometry Likelihood Model (Noise Parameters - Tune if odometry is poor) -->
    <!-- These defaults are common, but might need adjustment based on your robot's odom quality -->
    <param name="srr" value="0.1"/>  <!-- Odometry error in translation from translation -->
    <param name="srt" value="0.2"/>  <!-- Odometry error in translation from rotation -->
    <param name="str" value="0.1"/>  <!-- Odometry error in rotation from translation -->
    <param name="stt" value="0.2"/>  <!-- Odometry error in rotation from rotation -->

    <!-- Other Parameters (Defaults are usually fine, tune if needed) -->
    <param name="sigma" value="0.05"/>
    <param name="kernelSize" value="1"/>
    <param name="lstep" value="0.05"/>
    <param name="astep" value="0.05"/>
    <param name="iterations" value="5"/>
    <param name="lsigma" value="0.075"/>
    <param name="ogain" value="3.0"/>
    <param name="llsamplerange" value="0.01"/>
    <param name="llsamplestep" value="0.01"/>
    <param name="lasamplerange" value="0.005"/>
    <param name="lasamplestep" value="0.005"/>
  </node>

  <!-- ===== RVIZ ===== -->
  <!-- It's highly recommended to create an RViz configuration file -->
  <!-- 1. Run RViz manually: rosrun rviz rviz -->
  <!-- 2. Add displays: Map (topic /map), LaserScan (topic from arg), TF, RobotModel (if you have URDF) -->
  <!-- 3. Set the "Fixed Frame" in RViz to "map" -->
  <!-- 4. Save the configuration (File -> Save Config As...) to, for example, -->
  <!--    `your_package_name/rviz/mapping_config.rviz` -->
  <!-- Then uncomment and use the line below. -->
  <!-- <node name="rviz" pkg="rviz" type="rviz" args="-d $(find your_package_name)/rviz/mapping_config.rviz" required="true" /> -->
  <node name="rviz" pkg="rviz" type="rviz" /> <!-- Starts RViz with default config -->

  <!-- ===== TELEOPERATION (OPTIONAL - Highly Recommended) ===== -->
  <!-- Example for keyboard teleop. Make sure to remap cmd_vel to your robot's topic -->
  <!-- Ensure your robot's driver subscribes to this cmd_vel topic -->
  <!--
  <node name="teleop_twist_keyboard" pkg="teleop_twist_keyboard" type="teleop_twist_keyboard.py" output="screen" launch-prefix="xterm -e">
    <remap from="cmd_vel" to="/your_robot_cmd_vel_topic"/>
  </node>
  -->

</launch>