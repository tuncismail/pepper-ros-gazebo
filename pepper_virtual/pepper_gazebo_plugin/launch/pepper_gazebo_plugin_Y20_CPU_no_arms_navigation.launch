<?xml version="1.0"?>
<launch>
  <!-- Load the URDF Model -->
  <include file="$(find pepper_description)/launch/pepper_upload_CPU_no_arms.launch" />  
  
  <!-- We resume the logic in empty_world.launch, changing only the name of the world to be launched -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find pepper_gazebo_plugin)/worlds/house1.world"/>
    <arg name="paused" value="false"/>
  </include>

  <!-- Call Pepper Robot Trajectory Controller -->
  <include file="$(find pepper_control)/launch/pepper_control_trajectory_no_arms.launch" />

  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" /> 

  <!-- Spawn a robot into Gazebo -->
  <node name="spawn_urdf" pkg="gazebo_ros" type="spawn_model"
    args="-param robot_description -urdf -x -1.0 -y 1.0 -z 0.0 -model pepper_MP" output="screen"/>

  <!-- <node name="lower_arms" pkg="pepper_gazebo_plugin" type="arms_down.sh" output="screen" /> -->

  <node name="head_up" pkg="pepper_gazebo_plugin" type="head_up.sh" output="screen" />

  <node name="laser_publisher" pkg="pepper_gazebo_plugin" type="laser_publisher.py"/>
  
  <!-- Temporarily provide map->odom transform until AMCL takes over -->
  <node pkg="tf" type="static_transform_publisher" name="map_to_odom" args="-1 1 0 0 0 0 map odom 100" />

  <!-- MAP SERVER - Load a pre-made map -->
  <arg name="map_file" default="$(find pepper_gazebo_plugin)/maps/map.yaml"/>
  <node name="map_server" pkg="map_server" type="map_server" args="$(arg map_file)" output="screen" />
  
  <!-- AMCL for localization -->
  <node pkg="amcl" type="amcl" name="amcl" output="screen">
    <param name="odom_frame_id" value="odom"/>
    <param name="base_frame_id" value="base_footprint"/>
    <param name="global_frame_id" value="map"/>
    <param name="initial_pose_x" value="-1.0"/>
    <param name="initial_pose_y" value="1.0"/>
    <param name="initial_pose_a" value="0.0"/>
    <!-- Pepper-specific parameters -->
    <param name="update_min_d" value="0.1"/>
    <param name="update_min_a" value="0.1"/>
    <param name="laser_max_beams" value="30"/>
    <param name="laser_model_type" value="likelihood_field"/>
    <remap from="scan" to="/pepper/scan_front"/>
  </node>
  
  <!-- Move base for navigation -->
  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
    <rosparam file="$(find pepper_gazebo_plugin)/config/costmap_common_params.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find pepper_gazebo_plugin)/config/costmap_common_params.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find pepper_gazebo_plugin)/config/local_costmap_params.yaml" command="load"/>
    <rosparam file="$(find pepper_gazebo_plugin)/config/global_costmap_params.yaml" command="load" />
    <rosparam file="$(find pepper_gazebo_plugin)/config/base_local_planner_params.yaml" command="load" />
    
    <!-- Remap topics to match Pepper's -->
    <remap from="cmd_vel" to="/pepper/cmd_vel"/>
    <remap from="odom" to="/pepper/odom"/>
    <remap from="scan" to="/pepper/scan_front"/>
  </node>

  <!-- Rviz configuration for navigation -->
  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find pepper_gazebo_plugin)/config/pepper_sensors.rviz" />
  
  <node pkg="leg_detector" type="leg_detector" name="leg_detector" args="scan:=/pepper/scan_front $(find leg_detector)/config/trained_leg_detector.yaml" output="screen">
    <param name="fixed_frame" type="string" value="odom"/>
  </node>


  <!-- Face detection node -->
  <node pkg="pepper_face_detector" type="face_detector_node.py" name="pepper_face_detector" output="screen">
    <!-- Parameters for the simplified face detector -->
    <param name="face_detection_threshold" value="0.7" />
    <param name="show_visualization" value="true" />
  </node>

  <!-- Leg-Face validator node -->
  <node pkg="pepper_face_detector" type="leg_face_validator.py" name="leg_face_validator" output="screen">
    <param name="max_distance" value="10.0" />
  </node>

</launch>